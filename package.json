{
  "name": "open-mercato-enrichment-treg",
  "version": "0.1.0",
  "type": "module",
  "description": "Open Mercato module that enriches CRM people and companies, tracks company signals and finds similar companies through treg.to.",
  "license": "MIT",
  "author": "Artur Chmaro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chmarusso/open-mercato-enrichment-treg.git"
  },
  "homepage": "https://github.com/Chmarusso/open-mercato-enrichment-treg#readme",
  "bugs": {
    "url": "https://github.com/Chmarusso/open-mercato-enrichment-treg/issues"
  },
  "keywords": [
    "open-mercato",
    "open-mercato-module",
    "crm",
    "enrichment",
    "treg"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./*.tsx": {
      "types": "./src/*.tsx",
      "default": "./dist/*.js"
    },
    "./*.json": "./src/*.json",
    "./*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    },
    "./*/*.json": "./src/*/*.json",
    "./*/*": {
      "types": [
        "./src/*/*.ts",
        "./src/*/*.tsx"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*.json": "./src/*/*/*.json",
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts",
        "./src/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*.json": "./src/*/*/*/*.json",
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts",
        "./src/*/*/*/*.tsx"
      ],
      "default": "./dist/*/*/*/*.js"
    }
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/decorators": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "@open-mercato/core": "^0.8.0",
    "@open-mercato/queue": "^0.8.0",
    "@open-mercato/shared": "^0.8.0",
    "@open-mercato/ui": "^0.8.0",
    "awilix": "^13.0.0",
    "lucide-react": "^1.0.0",
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/decorators": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "@open-mercato/core": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/events": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/queue": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/search": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/shared": "0.8.1-develop.7297.1.67605e74f9",
    "@open-mercato/ui": "0.8.1-develop.7297.1.67605e74f9",
    "@playwright/test": "^1.56.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@tanstack/react-query": "^5.102.8",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "bullmq-otel": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "esbuild": "^0.25.0",
    "glob": "^13.0.6",
    "ioredis": "^5.0.0",
    "jest": "^30.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.6.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
